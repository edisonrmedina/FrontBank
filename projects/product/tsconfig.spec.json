{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jasmine", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "es2020",
    "lib": ["es2020", "dom"]
  },
  "files": ["src/test.ts", "src/polyfills.ts"],
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.d.ts"],
  "exclude": ["src/**/*.e2e-spec.ts"]
}
